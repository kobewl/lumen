# Lumen 服务端环境变量样例
#
# ⚠️ 重要：这个文件是**样例**，只用于说明需要哪些变量，所有值都是占位符。
#    真实配置放在服务器 /etc/lumen/lumen.env，权限 0640 root:lumen，
#    绝不提交到 Git、绝不进入 GitHub Actions、绝不打进镜像。
#
# 部署步骤：
#   sudo mkdir -p /etc/lumen
#   sudo cp lumen.env.example /etc/lumen/lumen.env
#   sudo chown root:lumen /etc/lumen/lumen.env
#   sudo chmod 0640 /etc/lumen/lumen.env
#   sudo vi /etc/lumen/lumen.env   # 填入真实密钥
#
# 生成随机令牌：openssl rand -base64 32

# ---- 基础 ----
LUMEN_LISTEN_ADDR=0.0.0.0:8787
LUMEN_DB_PATH=/data/lumen.db
LUMEN_BACKUP_DIR=/data/backups
LUMEN_TIMEZONE=Asia/Shanghai
LUMEN_LOG_LEVEL=info

# ---- 设备注册（务必在首次注册后清空或轮换）----
# Desktop 端运行 `lumen-desktop register --token <这个值>` 完成配对。
LUMEN_ENROLLMENT_TOKEN=replace-with-a-random-enrollment-token

# ---- 管理接口（手工触发总结生成、补发通知）----
LUMEN_ADMIN_TOKEN=replace-with-a-random-admin-token

# ---- DeepSeek（业务密钥，只在服务器）----
LUMEN_DEEPSEEK_BASE_URL=https://api.deepseek.com
LUMEN_DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
LUMEN_DEEPSEEK_MODEL=deepseek-chat
LUMEN_DEEPSEEK_TIMEOUT_SECONDS=60

# 每日总结与问答的调用预算，防止费用失控。
LUMEN_AI_SUMMARY_DAILY_LIMIT=2
LUMEN_AI_QUERY_DAILY_LIMIT=20
LUMEN_AI_DAILY_TOKEN_LIMIT=200000

# 每日总结触发时间（本地时区，默认 22:30）
LUMEN_SUMMARY_HOUR=22
LUMEN_SUMMARY_MINUTE=30

# ---- 助手身份（不是密钥，可以随时改）----
# 助手怎么称呼自己、怎么称呼你，都由这里决定；代码里不写死助手名字。
# 改完重启服务即生效，不需要重新编译。
LUMEN_ASSISTANT_NAME=Lumen
LUMEN_ASSISTANT_ROLE=个人助手/伙伴
# 留空则不称呼你的名字（助手不会自己给你起名字）。
LUMEN_OWNER_DISPLAY_NAME=
LUMEN_ASSISTANT_LANGUAGE=zh-CN
LUMEN_ASSISTANT_TONE=友好、简洁、像朋友
LUMEN_ASSISTANT_PROACTIVITY=低：只在被问到或明确需要时回应，不主动打扰

# ---- 飞书（业务密钥，只在服务器）----
# 留空则关闭飞书能力，不影响采集、同步与总结生成。
LUMEN_FEISHU_APP_ID=
LUMEN_FEISHU_APP_SECRET=
# 只响应这些用户的消息，多个用逗号分隔。为空时飞书整体禁用。
LUMEN_FEISHU_ALLOWED_USER_IDS=
LUMEN_FEISHU_CONNECTION_MODE=long_connection

# ---- 数据保留与限制 ----
LUMEN_EVENT_RETENTION_DAYS=30
LUMEN_MAX_BATCH_BYTES=524288
LUMEN_MAX_EVENT_BYTES=65536
LUMEN_MAX_BATCH_EVENTS=500
LUMEN_CLOCK_SKEW_TOLERANCE_SECONDS=300
