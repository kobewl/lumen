{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lumen.local/schemas/sync.schema.json",
  "title": "Lumen Sync Batch",
  "description": "Desktop 批量上传请求与服务端逐事件 ACK 响应。投递语义 at-least-once，服务端按 event_id 幂等。",
  "definitions": {
    "batch_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device_id", "batch_id", "sent_at", "events"],
      "properties": {
        "device_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "batch_id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
        "sent_at": { "type": "string", "format": "date-time" },
        "events": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": { "$ref": "https://lumen.local/schemas/event.schema.json" }
        }
      }
    },
    "event_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "status"],
      "properties": {
        "event_id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
        "status": { "type": "string", "enum": ["accepted", "duplicate", "rejected"] },
        "code": { "type": "string", "maxLength": 64 },
        "message": { "type": "string", "maxLength": 200 },
        "clock_skew": { "type": "boolean" }
      }
    },
    "batch_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batch_id", "server_time", "results"],
      "properties": {
        "batch_id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
        "server_time": { "type": "string", "format": "date-time" },
        "results": {
          "type": "array",
          "items": { "$ref": "#/definitions/event_result" }
        },
        "rejected_batch": { "type": "boolean" }
      }
    },
    "error_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "maxLength": 64 },
        "message": { "type": "string", "maxLength": 200 }
      }
    }
  }
}
