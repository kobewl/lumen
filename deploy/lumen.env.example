# 程序不自动加载此文件，由 shell 或服务管理器注入。
LUMEN_HOST=127.0.0.1
LUMEN_PORT=8787
LUMEN_DB_PATH=data/lumen-v001.db
LUMEN_TIMEZONE=Asia/Shanghai
LUMEN_MODEL_BASE_URL=https://api.deepseek.com
LUMEN_MODEL=deepseek-chat
LUMEN_MODEL_API_KEY=
LUMEN_MODEL_TIMEOUT_SECONDS=45
# 统计模型成功调用，不统计 /today 等本地快捷命令；0 禁用模型调用。
LUMEN_MODEL_DAILY_CALL_LIMIT=120
LUMEN_ASSISTANT_NAME=Lumen
LUMEN_ASSISTANT_TONE=友好、简洁
# 非本地监听必需，至少 24 字符；通过 HTTPS 访问。
LUMEN_ACCESS_TOKEN=
# localhost 后的反向代理使用自定义域名时填写，不含协议/端口，逗号分隔。
LUMEN_ALLOWED_HOSTS=
LUMEN_FEISHU_APP_ID=
LUMEN_FEISHU_APP_SECRET=
LUMEN_FEISHU_ALLOWED_USER_IDS=
# 默认每日一致性备份，自动备份保留最近 7 份；手动备份不参与轮转。
LUMEN_AUTO_BACKUP=true
LUMEN_BACKUP_DIR=
