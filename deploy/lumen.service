[Unit]
Description=Lumen personal assistant
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lumen
Group=lumen
WorkingDirectory=/opt/lumen
EnvironmentFile=/etc/lumen/lumen.env
ExecStart=/opt/lumen/.venv/bin/python -m lumen
Restart=on-failure
RestartSec=5
TimeoutStopSec=180
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/lumen

[Install]
WantedBy=multi-user.target
